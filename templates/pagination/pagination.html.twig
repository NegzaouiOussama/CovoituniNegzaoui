{% if pageCount > 1 %}
    <div class="inline-flex rounded-md shadow-sm">
        {% if first is defined and current != first %}
            <a class="inline-flex items-center px-4 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50"
               href="{{ path(route, query|merge({(pageParameterName): first})) }}">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                First
            </a>
        {% endif %}

        {% if previous is defined %}
            <a class="inline-flex items-center px-4 py-2 {% if first is not defined %}rounded-l-md{% endif %} border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50"
               href="{{ path(route, query|merge({(pageParameterName): previous})) }}">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Prev
            </a>
        {% endif %}

        {% for page in pagesInRange %}
            {% if page != current %}
                <a class="inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50"
                   href="{{ path(route, query|merge({(pageParameterName): page})) }}">{{ page }}</a>
            {% else %}
                <span class="inline-flex items-center px-4 py-2 border border-primary-500 bg-primary-100 text-sm font-medium text-primary-700">{{ page }}</span>
            {% endif %}
        {% endfor %}

        {% if next is defined %}
            <a class="inline-flex items-center px-4 py-2 {% if last is not defined %}rounded-r-md{% endif %} border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50"
               href="{{ path(route, query|merge({(pageParameterName): next})) }}">
                Next
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
            </a>
        {% endif %}

        {% if last is defined and current != last %}
            <a class="inline-flex items-center px-4 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50"
               href="{{ path(route, query|merge({(pageParameterName): last})) }}">
                Last
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
            </a>
        {% endif %}
    </div>
{% endif %} 