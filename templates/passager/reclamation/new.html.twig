{% extends 'layouts/user_layout.html.twig' %}

{% block title %}Nouvelle réclamation{% endblock %}

{# Simple validation macro #}
{% macro validate_field(id, minLength, maxLength, minErrorMessage, maxErrorMessage) %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const field = document.getElementById('{{ id }}');
            const errorEl = document.getElementById('{{ id }}_error');
            
            if (field && errorEl) {
                field.addEventListener('input', function() {
                    const value = this.value.trim();
                    
                    if (value.length < {{ minLength }}) {
                        field.classList.add('border-red-500');
                        errorEl.classList.remove('hidden');
                        errorEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" /></svg> {{ minErrorMessage }}';
                    } 
                    {% if maxLength %}
                    else if (value.length > {{ maxLength }}) {
                        field.classList.add('border-red-500');
                        errorEl.classList.remove('hidden');
                        errorEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" /></svg> {{ maxErrorMessage }}';
                    } 
                    {% endif %}
                    else {
                        field.classList.remove('border-red-500');
                        errorEl.classList.add('hidden');
                    }
                });
            }
        });
    </script>
{% endmacro %}

{% block content %}
    {% import _self as validator %}
    
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <h1 class="text-3xl font-bold text-gray-800">Nouvelle réclamation</h1>
            <a href="{{ path('app_passager_mes_reclamations') }}" 
               class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 rounded-xl hover:bg-gray-300 transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Retour à la liste
            </a>
        </div>
        
        <p class="text-gray-600 mt-2">Décrivez votre problème ou votre demande en détail</p>
    </div>
    
    <div class="glass-card bg-white/90 backdrop-blur-sm border border-white/30 rounded-xl shadow-xl p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-6', 'id': 'reclamationForm'}}) }}
            <div class="mb-6">
                <label for="{{ form.subject.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">
                    Sujet de la réclamation <span class="text-red-500">*</span>
                </label>
                {{ form_widget(form.subject, {
                    'attr': {
                        'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50',
                        'placeholder': 'Sujet de votre réclamation',
                        'minlength': 5,
                        'maxlength': 255,
                        'id': 'subject'
                    }
                }) }}
                <div class="flex justify-between">
                    <p class="text-xs text-gray-500 mt-1">Le sujet doit contenir entre 5 et 255 caractères</p>
                    <p class="text-xs text-gray-500 mt-1"><span id="subjectCharCount">0</span>/255</p>
                </div>
                <div class="mt-1 text-sm text-red-600" id="subject_error_server">
                    {% if form.subject.vars.errors|length > 0 %}
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
                            </svg>
                            <span>{{ form_errors(form.subject) }}</span>
                        </div>
                    {% endif %}
                </div>
                <div id="subject_error" class="mt-1 text-sm text-red-600 hidden"></div>
            </div>
            
            <div class="mb-6">
                <label for="{{ form.description.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">
                    Description détaillée <span class="text-red-500">*</span>
                </label>
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50',
                        'rows': 6,
                        'placeholder': 'Décrivez votre problème en détail...',
                        'data-controller': 'ckeditor',
                        'data-ckeditor-config': 'default',
                        'minlength': 5,
                        'id': 'description'
                    }
                }) }}
                <div class="flex justify-between">
                    <p class="text-xs text-gray-500 mt-1">La description doit contenir au moins 5 caractères</p>
                </div>
                <div class="mt-1 text-sm text-red-600" id="description_error_server">
                    {% if form.description.vars.errors|length > 0 %}
                        <div class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
                            </svg>
                            <span>{{ form_errors(form.description) }}</span>
                        </div>
                    {% endif %}
                </div>
                <div id="description_error" class="mt-1 text-sm text-red-600 hidden"></div>
            </div>
            
            <div class="mt-8 flex justify-end">
                <button type="submit" class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-primary to-primary-dark text-white rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 text-sm font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    Envoyer la réclamation
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    {# Apply validation for subject field #}
    {{ validator.validate_field(
        'subject',
        5,
        255,
        'Ce texte est trop court. Il doit contenir 5 caractères ou plus.',
        'Ce texte est trop long. Il doit contenir 255 caractères ou moins.'
    ) }}

    {# Custom validation for CKEditor description field #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('reclamationForm');
            const subjectField = document.getElementById('subject');
            const subjectCharCount = document.getElementById('subjectCharCount');
            let editor;
            
            // Update character count for subject
            if (subjectField) {
                // Set initial count
                subjectCharCount.textContent = subjectField.value.length;
                
                subjectField.addEventListener('input', function() {
                    subjectCharCount.textContent = this.value.length;
                });
            }
            
            // Connect to the ckeditor controller when it's initialized
            document.addEventListener('stimulus:connected', function(event) {
                if (event.detail.controller.identifier === 'ckeditor') {
                    editor = event.detail.controller.editor;
                }
            });
            
            // Form validation on submit
            if (form) {
                form.addEventListener('submit', function(event) {
                    // Validate description with CKEditor if available
                    const descriptionField = document.getElementById('description');
                    const descriptionError = document.getElementById('description_error');
                    
                    if (descriptionField && editor && descriptionError) {
                        const content = editor.getData();
                        const plainText = content.replace(/<[^>]*>/g, '').trim();
                        
                        if (plainText.length < 5) {
                            event.preventDefault();
                            descriptionField.classList.add('border-red-500');
                            descriptionError.classList.remove('hidden');
                            descriptionError.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" /></svg> Ce texte est trop court. Il doit contenir 5 caractères ou plus.';
                        } else {
                            descriptionError.classList.add('hidden');
                            descriptionField.classList.remove('border-red-500');
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %} 