    {# Add custom styles for animations #}
    <style>
        @keyframes subtle-zoom {
            from { transform: scale(1); }
            to { transform: scale(1.05); }
        }
        @keyframes gradient-x {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        @keyframes car-move {
            0% { transform: translateX(-100px); }
            100% { transform: translateX(calc(100vw + 100px)); }
        }
        @keyframes fade-in-up {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        @keyframes bounce-slow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .animate-subtle-zoom {
            animation: subtle-zoom 20s ease-in-out infinite alternate;
        }
        .animate-gradient-x {
            animation: gradient-x 15s ease infinite;
            background-size: 200% 200%;
        }
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animate-car-move {
            animation: car-move 20s linear infinite;
        }
        .animate-fade-in-up {
            animation: fade-in-up 1s ease-out forwards;
        }
        .animate-bounce-slow {
            animation: bounce-slow 3s ease-in-out infinite;
        }
        .animation-delay-500 {
            animation-delay: 0.5s;
        }
        .animation-delay-1000 {
            animation-delay: 1s;
        }
        .animation-delay-1500 {
            animation-delay: 1.5s;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-3000 {
            animation-delay: 3s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
        
        /* 3D Perspective Styles */
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .rotate-y-3 {
            transform: rotateY(3deg);
        }
        
        /* Pulse ring effect */
        .pulse-ring {
            position: absolute;
            width: 45px;
            height: 45px;
            border-radius: 100%;
            background-color: transparent;
            border: 2px solid rgba(255, 255, 255, 0.4);
            animation: pulse-ring 2s infinite;
        }
        
        @keyframes pulse-ring {
            0% {
                transform: scale(0.5);
                opacity: 0;
            }
            50% {
                opacity: 0.5;
            }
            100% {
                transform: scale(2);
                opacity: 0;
            }
        }
        
        /* Hide scrollbar but allow scrolling */
        .scrollbar-hide {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;  /* Chrome, Safari and Opera */
        }
    </style>

    {# Add JavaScript for real-time features #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Counter animation
            const counters = document.querySelectorAll('.counter');
            const speed = 200;
            
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const increment = target / speed;
                
                const updateCount = () => {
                    const count = +counter.innerText;
                    if (count < target) {
                        counter.innerText = Math.ceil(count + increment);
                        setTimeout(updateCount, 1);
                    } else {
                        counter.innerText = target;
                    }
                };
                
                updateCount();
            });
            
            // Simulate real-time active users
            setInterval(() => {
                const activeUsersElement = document.getElementById('activeUsers');
                const currentUsers = parseInt(activeUsersElement.textContent);
                const change = Math.floor(Math.random() * 5) - 2; // Random change between -2 and +2
                const newValue = Math.max(15, currentUsers + change);
                activeUsersElement.textContent = newValue;
                
                // Also update active rides randomly
                const activeRidesElement = document.getElementById('activeRides');
                const currentRides = parseInt(activeRidesElement.textContent);
                const ridesChange = Math.random() > 0.7 ? (Math.random() > 0.5 ? 1 : -1) : 0;
                const newRides = Math.max(3, currentRides + ridesChange);
                activeRidesElement.textContent = newRides;
            }, 5000);
            
            // Simulate real-time notifications
            const notifications = [
                "New ride from Paris to Lyon just posted!",
                "Alex just booked a ride to Bordeaux",
                "Emma saved €15 with carpooling today",
                "New weekend event: Campus Music Festival",
                "3 new rides added for university routes",
                "Lucas completed his 10th ride this month"
            ];
            
            const notificationContainer = document.getElementById('notificationContainer');
            
            function addNotification() {
                if (Math.random() > 0.6) { // 40% chance to show notification
                    const notification = document.createElement('div');
                    notification.className = 'bg-white/90 backdrop-blur-sm border border-primary/20 rounded-lg p-4 shadow-lg transform transition-all duration-500 animate-fade-in-up flex items-start';
                    
                    const dot = document.createElement('span');
                    dot.className = 'inline-block w-2 h-2 bg-primary rounded-full mr-2 mt-2 flex-shrink-0';
                    
                    const text = document.createElement('p');
                    text.className = 'text-sm text-gray-700';
                    text.textContent = notifications[Math.floor(Math.random() * notifications.length)];
                    
                    notification.appendChild(dot);
                    notification.appendChild(text);
                    notificationContainer.appendChild(notification);
                    
                    // Remove notification after 5 seconds
                    setTimeout(() => {
                        notification.style.opacity = '0';
                        notification.style.transform = 'translateY(10px)';
                        setTimeout(() => {
                            notification.remove();
                        }, 500);
                    }, 5000);
                }
                
                // Maximum 3 notifications at once
                if (notificationContainer.children.length > 3) {
                    notificationContainer.removeChild(notificationContainer.children[0]);
                }
            }
            
            // Add notifications periodically
            setInterval(addNotification, 8000);
            // Add first notification after 3 seconds
            setTimeout(addNotification, 3000);
            
            // Old map code to remove
            // Simulate map loading
            // setTimeout(() => {
            //     const mapElement = document.getElementById('liveMap');
            //     mapElement.innerHTML = `
            //         <div class="w-full h-full bg-gray-100 flex items-center justify-center">
            //             <img src="https://i.imgur.com/JVzsIsL.png" alt="Map visualization" class="w-full h-full object-cover" />
            //         </div>
            //     `;
            // }, 1500);
            
            // Slider functionality
            const sliderContainer = document.getElementById('destinationsSlider');
            const slideLeftBtn = document.getElementById('slideLeft');
            const slideRightBtn = document.getElementById('slideRight');
            
            if (slideLeftBtn && slideRightBtn && sliderContainer) {
                slideLeftBtn.addEventListener('click', () => {
                    sliderContainer.scrollBy({
                        left: -350,
                        behavior: 'smooth'
                    });
                });
                
                slideRightBtn.addEventListener('click', () => {
                    sliderContainer.scrollBy({
                        left: 350,
                        behavior: 'smooth'
                    });
                });
            }
            
            // Add 3D tilt effect on mouse move for hero section
            const heroSection = document.querySelector('.perspective-1000');
            const heroContent = heroSection.querySelector('.z-10');
            
            if (heroSection && heroContent) {
                heroSection.addEventListener('mousemove', (e) => {
                    const xAxis = (window.innerWidth / 2 - e.pageX) / 100;
                    const yAxis = (window.innerHeight / 2 - e.pageY) / 100;
                    
                    heroContent.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
                });
                
                // Reset transform on mouse leave
                heroSection.addEventListener('mouseleave', () => {
                    heroContent.style.transform = 'rotateY(0deg) rotateX(0deg)';
                    // Add transition for smooth reset
                    heroContent.style.transition = 'transform 0.5s ease';
                });
                
                // Reset transform on mouse enter
                heroSection.addEventListener('mouseenter', () => {
                    // Remove transition after a short delay for smooth movement
                    setTimeout(() => {
                        heroContent.style.transition = 'none';
                    }, 100);
                });
            }

            // Interactive search functionality
            const fromInput = document.querySelector('input[placeholder="From (city or destination)"]');
            const toInput = document.querySelector('input[placeholder="To (city or destination)"]');
            const suggestionsFrom = document.querySelector('.suggestions-from');
            const suggestionsTo = document.querySelector('.suggestions-to');
            const searchBtn = document.getElementById('searchRidesBtn');
            const searchResults = document.getElementById('searchResults');
            const searchLoader = document.getElementById('searchLoader');
            const rideResultsList = document.getElementById('rideResultsList');
            
            // Show suggestions when input is focused
            if (fromInput && suggestionsFrom) {
                fromInput.addEventListener('focus', () => {
                    suggestionsFrom.classList.remove('hidden');
                });
                
                fromInput.addEventListener('blur', () => {
                    // Small delay to allow for clicking on suggestions
                    setTimeout(() => {
                        suggestionsFrom.classList.add('hidden');
                    }, 200);
                });
            }
            
            if (toInput && suggestionsTo) {
                toInput.addEventListener('focus', () => {
                    suggestionsTo.classList.remove('hidden');
                });
                
                toInput.addEventListener('blur', () => {
                    // Small delay to allow for clicking on suggestions
                    setTimeout(() => {
                        suggestionsTo.classList.add('hidden');
                    }, 200);
                });
            }
            
            // Select suggestion when clicked
            document.querySelectorAll('.suggestion-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    const value = e.target.textContent;
                    if (e.target.closest('.suggestions-from')) {
                        fromInput.value = value;
                        suggestionsFrom.classList.add('hidden');
                    } else if (e.target.closest('.suggestions-to')) {
                        toInput.value = value;
                        suggestionsTo.classList.add('hidden');
                    }
                });
            });
            
            // Handle search button click
            if (searchBtn && searchResults && searchLoader && rideResultsList) {
                searchBtn.addEventListener('click', () => {
                    // Show search results section
                    searchResults.classList.remove('hidden');
                    searchLoader.classList.remove('hidden');
                    rideResultsList.classList.add('hidden');
                    
                    // Simulate API call
                    setTimeout(() => {
                        searchLoader.classList.add('hidden');
                        rideResultsList.classList.remove('hidden');
                    }, 1500);
                });
            }

            // Initialize OpenStreetMap
            const mapElement = document.getElementById('liveMap');
            if (mapElement) {
                // Center map on Tunisia
                const map = L.map('liveMap').setView([34.0, 9.0], 7);
                
                // Use a prettier map style
                L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                    subdomains: 'abcd',
                    maxZoom: 19
                }).addTo(map);
                
                // Define popular locations in Tunisia with improved marker data
                const locations = [
                    { name: "Tunis", location: [36.8065, 10.1815], rides: 15, type: "capital" },
                    { name: "Sousse", location: [35.8245, 10.6346], rides: 12, type: "beach" },
                    { name: "Sfax", location: [34.7478, 10.7661], rides: 8, type: "city" },
                    { name: "Monastir", location: [35.7643, 10.8113], rides: 10, type: "beach" },
                    { name: "Hammamet", location: [36.4074, 10.6225], rides: 7, type: "beach" },
                    { name: "Bizerte", location: [37.2746, 9.8714], rides: 5, type: "city" },
                    { name: "Djerba", location: [33.8075, 10.8451], rides: 6, type: "island" }
                ];
                
                // Enhanced marker icons based on location type
                const createLocationIcon = (loc) => {
                    let bgColor = 'bg-primary';
                    
                    // Different colors based on location type
                    if (loc.type === 'beach') bgColor = 'bg-blue-500';
                    else if (loc.type === 'capital') bgColor = 'bg-purple-600';
                    else if (loc.type === 'island') bgColor = 'bg-emerald-500';
                    
                    return L.divIcon({
                        className: 'custom-location-marker',
                        html: `
                            <div class="${bgColor} text-white font-bold rounded-full w-9 h-9 flex items-center justify-center shadow-lg border-2 border-white">
                                ${loc.rides}
                            </div>
                        `,
                        iconSize: [36, 36],
                        iconAnchor: [18, 18]
                    });
                };
                
                // Add markers with enhanced styling
                const markers = {};
                locations.forEach(loc => {
                    // Create enhanced marker
                    const marker = L.marker(loc.location, {
                        icon: createLocationIcon(loc),
                        riseOnHover: true
                    }).addTo(map);
                    
                    // Enhanced popup with more details
                    marker.bindPopup(`
                        <div class="text-center p-1">
                            <h3 class="font-bold text-primary text-lg">${loc.name}</h3>
                            <p class="text-sm text-gray-600 mb-2">${loc.rides} active rides</p>
                            <button class="w-full mt-1 px-3 py-1.5 bg-primary text-white text-xs rounded-lg hover:bg-primary-dark transition-colors">
                                View Available Rides
                            </button>
                        </div>
                    `);
                    
                    // Store marker reference for later use
                    markers[loc.name] = marker;
                });
                
                // Define realistic routes between cities using Leaflet Routing Machine
                const routeOptions = {
                    // Real-world routes
                    routes: [
                        { from: "Tunis", to: "Sousse", color: '#10B981', weight: 5, active: 3 },
                        { from: "Tunis", to: "Sfax", color: '#3B82F6', weight: 4, active: 2 },
                        { from: "Sousse", to: "Monastir", color: '#8B5CF6', weight: 4, active: 1 },
                        { from: "Tunis", to: "Hammamet", color: '#3B82F6', weight: 4, active: 2 }
                    ]
                };
                
                // Function to create realistic routes with road data
                const createRealisticRoute = (fromName, toName, color, weight, active) => {
                    const fromMarker = markers[fromName];
                    const toMarker = markers[toName];
                    
                    if (!fromMarker || !toMarker) return null;
                    
                    // Create a routing control that follows actual roads
                    const control = L.Routing.control({
                        waypoints: [
                            L.latLng(fromMarker.getLatLng()),
                            L.latLng(toMarker.getLatLng())
                        ],
                        show: false, // Hide the routing interface
                        routeWhileDragging: false,
                        lineOptions: {
                            styles: [
                                { color: color, opacity: 0.8, weight: weight }
                            ],
                            addWaypoints: false,
                            extendToWaypoints: false,
                            missingRouteTolerance: 0
                        },
                        createMarker: function() { return null; }, // Don't create markers at endpoints
                        fitSelectedRoutes: false
                    }).addTo(map);
                    
                    // When the route is drawn, add a popup with information
                    control.on('routesfound', function(e) {
                        const routes = e.routes;
                        const route = routes[0];
                        
                        // Extract all coordinates from the route
                        const coords = route.coordinates;
                        
                        // Create a polyline for the route that we can use for the popup
                        const polyline = L.polyline(coords, {
                            color: color,
                            weight: weight,
                            opacity: 0.8
                        });
                        
                        // Find the middle point of the route for the popup position
                        const middleIdx = Math.floor(coords.length / 2);
                        const middlePoint = coords[middleIdx];
                        
                        // Add a popup to the route
                        const popup = L.popup({
                            closeButton: false,
                            offset: [0, -weight]
                        })
                        .setLatLng(middlePoint)
                        .setContent(`
                            <div class="text-center py-1 px-2">
                                <p class="font-bold text-primary text-sm">${fromName} → ${toName}</p>
                                <div class="text-xs">
                                    <span class="font-medium">${active} active ride(s)</span><br>
                                    <span>${Math.round(route.summary.totalDistance / 1000)} km · ${Math.round(route.summary.totalTime / 60)} min</span>
                                </div>
                            </div>
                        `);
                        
                        // Add hovering effect to show popup
                        polyline.on('mouseover', function() {
                            map.openPopup(popup);
                        });
                        
                        polyline.on('mouseout', function() {
                            map.closePopup(popup);
                        });
                        
                        // Add click event to show the popup
                        polyline.on('click', function() {
                            map.openPopup(popup);
                        });
                        
                        // Animate dots along the route
                        animateAlongRoute(coords, color);
                    });
                    
                    return control;
                };
                
                // Create all real-world routes
                setTimeout(() => {
                    routeOptions.routes.forEach(route => {
                        createRealisticRoute(route.from, route.to, route.color, route.weight, route.active);
                    });
                }, 1000); // Delay routing to ensure map is fully loaded
                
                // Function to animate a dot along a real route
                function animateAlongRoute(coordinates, color) {
                    if (!coordinates || coordinates.length < 2) return;
                    
                    // Create a moving dot icon with the route color
                    const dotIcon = L.divIcon({
                        className: 'moving-dot',
                        html: `<div class="w-3 h-3 rounded-full shadow-lg animate-pulse" style="background-color: ${color}"></div>`,
                        iconSize: [12, 12],
                        iconAnchor: [6, 6]
                    });
                    
                    // Create marker and add to map at the start position
                    const movingDot = L.marker(coordinates[0], {icon: dotIcon}).addTo(map);
                    
                    // Animate along the path
                    let idx = 0;
                    const maxIdx = coordinates.length - 1;
                    
                    const moveInterval = setInterval(() => {
                        // Update marker position to next coordinate
                        movingDot.setLatLng(coordinates[idx]);
                        
                        // Increment position
                        idx += 1;
                        
                        // When we reach the end, start over
                        if (idx > maxIdx) {
                            idx = 0;
                        }
                    }, 150); // Speed of movement
                    
                    // Return interval for potential cleanup
                    return moveInterval;
                }
            }
        });
    </script>
