{% extends 'base.html.twig' %}

{% block title %}CovoitUni - Carpooling in Tunisia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin=""/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
    <style>
        /* Additional styles for the map */
        .custom-uni-marker {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .custom-location-marker div {
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        }
        .custom-location-marker div:hover {
            transform: scale(1.2);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        }
        .leaflet-popup-content-wrapper {
            border-radius: 0.75rem;
            padding: 0.5rem;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        }
        .leaflet-popup-content-wrapper button {
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .leaflet-popup-content-wrapper button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        .leaflet-popup-content {
            margin: 10px 12px;
        }
        /* Enhanced map controls */
        .leaflet-control-zoom {
            border-radius: 0.5rem !important;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06) !important;
        }
        .leaflet-control-zoom a {
            background-color: white !important;
            color: #10B981 !important;
            transition: all 0.2s ease;
        }
        .leaflet-control-zoom a:hover {
            background-color: #f9fafb !important;
            color: #059669 !important;
        }
        .leaflet-control-attribution {
            background-color: rgba(255,255,255,0.8) !important;
            backdrop-filter: blur(2px);
            border-radius: 0.25rem;
        }
        /* Custom animated pulse for moving dots */
        @keyframes map-dot-pulse {
            0% { transform: scale(0.8); opacity: 0.7; }
            50% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(0.8); opacity: 0.7; }
        }
        .moving-dot div {
            animation: map-dot-pulse 1.5s infinite ease-in-out;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
{% endblock %}

{% block body %}
    {# Hero Section with Enhanced Animation #}
    <div class="relative min-h-screen w-full flex items-center justify-center overflow-hidden perspective-1000">
        {# Background Image with Enhanced Parallax Effect #}
        <div class="absolute inset-0 z-0 transform-style-3d rotate-y-3 scale-105">
