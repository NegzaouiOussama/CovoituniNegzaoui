    {# Live Map Section #}
    <section class="relative py-24 w-full bg-gradient-to-b from-white to-primary-ultra-light/30">
        <div class="container mx-auto px-4">
            <h2 class="section-title text-4xl md:text-5xl font-bold text-center mb-6">
