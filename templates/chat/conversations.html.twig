{% extends 'layouts/user_layout.html.twig' %}

{% block title %}Mes Conversations{% endblock %}

{% block content %}
<div class="w-full">
    <div class="glass-card bg-white/90 backdrop-blur-sm border border-white/30 rounded-xl shadow-xl p-8 mb-8">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-bold mb-2 text-gray-800">Mes Conversations</h1>
                <p class="text-gray-600">
                    Retrouvez ici toutes vos conversations avec les conducteurs et passagers.
                    {% if unreadCount > 0 %}
                        <span class="px-2 py-1 ml-2 bg-red-100 text-red-800 text-xs font-semibold rounded-full">
                            {{ unreadCount }} non {{ unreadCount > 1 ? 'lus' : 'lu' }}
                        </span>
                    {% endif %}
                </p>
            </div>
        </div>

        <div class="mt-6">
            {% if conversations is empty %}
                <div class="bg-gray-50 rounded-xl p-8 text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                    </svg>
                    <h3 class="mt-4 text-xl font-medium text-gray-900">Aucune conversation</h3>
                    <p class="mt-2 text-gray-600">Vous n'avez pas encore de conversations actives.</p>
                </div>
            {% else %}
                <div class="space-y-4">
                    {% for conversation in conversations %}
                        {% set otherUserId = conversation.senderId == app.user.id ? conversation.receiverId : conversation.senderId %}
                        <a href="{{ path('app_chat_conversation', {'reservationId': conversation.reservationId, 'type': conversation.reservationType}) }}" 
                           class="block bg-white shadow-md hover:shadow-lg transition-shadow duration-300 rounded-xl overflow-hidden">
                            <div class="p-4">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h3 class="font-bold text-gray-900">
                                            {% if conversation.reservationType == 'TRAJET' %}
                                                Réservation trajet
                                            {% else %}
                                                Réservation événement
                                            {% endif %}
                                            #{{ conversation.reservationId }}
                                        </h3>
                                        <p class="text-sm text-gray-500">
                                            {{ conversation.createdAt|date('d/m/Y à H:i') }}
                                        </p>
                                    </div>
                                    {% if conversation.receiverId == app.user.id and not conversation.readAt %}
                                        <span class="px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">
                                            Nouveau
                                        </span>
                                    {% endif %}
                                </div>
                                
                                <div class="mt-2 text-gray-600 truncate">
                                    <p>{{ conversation.content|truncate(100) }}</p>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 