{% extends 'base.html.twig' %}

{% block title %}Gestion des Avis{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .rating {
            display: inline-flex;
            margin-right: 0.5rem;
        }
        .rating-star {
            color: #EAB308;
        }
        .filter-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.5rem;
            border-radius: 0.375rem;
            font-size: 0.75rem;
            font-weight: 500;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden p-6">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-6">
                    <div>
                        <h1 class="text-3xl font-bold bg-gradient-to-r from-green-600 to-green-700 bg-clip-text text-transparent">Gestion des Avis</h1>
                        <p class="text-gray-500 mt-1">Administration des avis clients</p>
                        <div class="h-1 w-32 bg-gradient-to-r from-green-500 to-green-600 rounded mt-2"></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_admin_dashboard') }}" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            Dashboard
                        </a>
                        <div class="dropdown inline-block relative">
                            <button class="bg-green-100 hover:bg-green-200 text-green-700 px-4 py-2 rounded-lg text-sm font-medium flex items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                Exporter
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="dropdown-menu absolute hidden bg-white min-w-full w-48 right-0 shadow-lg rounded-lg overflow-hidden z-10">
                                <a href="{{ path('app_admin_avis_export_csv') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                                    Export CSV
                                </a>
                                <a href="{{ path('app_admin_avis_export_excel') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                                    Export Excel
                                </a>
                                <a href="{{ path('app_admin_avis_export_json') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                                    Export JSON
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                    <!-- Average Rating -->
                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-blue-100 text-blue-600 mr-4">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-500 text-sm">Note moyenne</p>
                                <p class="text-2xl font-bold text-gray-800">{{ stats.averageRating|number_format(1) }}/5</p>
                                <div class="rating">
                                    {% for i in 1..5 %}
                                        {% if i <= stats.averageRating %}
                                            <span class="rating-star">★</span>
                                        {% else %}
                                            {% if i - stats.averageRating < 1 and i - stats.averageRating > 0 %}
                                                <span class="rating-star">★</span>
                                            {% else %}
                                                <span class="rating-star text-gray-300">★</span>
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Total Reviews -->
                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-green-100 text-green-600 mr-4">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-500 text-sm">Total des avis</p>
                                <p class="text-2xl font-bold text-gray-800">{{ stats.total }}</p>
                                <p class="text-sm text-gray-500">Depuis le début</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Positive Sentiment -->
                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-green-100 text-green-600 mr-4">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-500 text-sm">Sentiment positif</p>
                                <p class="text-2xl font-bold text-gray-800">{{ stats.sentiment.positive }}</p>
                                <p class="text-sm text-gray-500">Avis positifs</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Negative Sentiment -->
                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-red-100 text-red-600 mr-4">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-500 text-sm">Sentiment négatif</p>
                                <p class="text-2xl font-bold text-gray-800">{{ stats.sentiment.negative }}</p>
                                <p class="text-sm text-gray-500">Avis négatifs</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Filters -->
                <div class="bg-gradient-to-r from-gray-50 to-gray-100 border border-gray-200 rounded-xl p-6 mb-6 shadow-sm">
                    <div class="flex items-center mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        <h2 class="text-lg font-medium text-gray-800">Filtres de recherche</h2>
                    </div>
                    
                    <form action="{{ path('app_admin_avis_index') }}" method="get">
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            <!-- Rating Filter -->
                            <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm transition-all duration-200 hover:shadow-md">
                                <label for="note" class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500 mr-1" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                    </svg>
                                    Note
                                </label>
                                <select id="note" name="note" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-300 focus:ring focus:ring-green-200 focus:ring-opacity-50 py-2">
                                    <option value="">Toutes les notes</option>
                                    <option value="5" {% if filter.note == '5' %}selected{% endif %}>5 étoiles</option>
                                    <option value="4" {% if filter.note == '4' %}selected{% endif %}>4 étoiles</option>
                                    <option value="3" {% if filter.note == '3' %}selected{% endif %}>3 étoiles</option>
                                    <option value="2" {% if filter.note == '2' %}selected{% endif %}>2 étoiles</option>
                                    <option value="1" {% if filter.note == '1' %}selected{% endif %}>1 étoile</option>
                                </select>
                            </div>
                            
                            <!-- Date Filter -->
                            <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm transition-all duration-200 hover:shadow-md">
                                <label for="date" class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                    Période
                                </label>
                                <select id="date" name="date" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-300 focus:ring focus:ring-green-200 focus:ring-opacity-50 py-2">
                                    <option value="">Toutes les dates</option>
                                    <option value="today" {% if filter.date == 'today' %}selected{% endif %}>Aujourd'hui</option>
                                    <option value="week" {% if filter.date == 'week' %}selected{% endif %}>Cette semaine</option>
                                    <option value="month" {% if filter.date == 'month' %}selected{% endif %}>Ce mois</option>
                                    <option value="year" {% if filter.date == 'year' %}selected{% endif %}>Cette année</option>
                                </select>
                            </div>
                            
                            <!-- Sentiment Filter -->
                            <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm transition-all duration-200 hover:shadow-md">
                                <label for="sentiment" class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Sentiment
                                </label>
                                <select id="sentiment" name="sentiment" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-green-300 focus:ring focus:ring-green-200 focus:ring-opacity-50 py-2">
                                    <option value="">Tous les sentiments</option>
                                    <option value="positive" {% if filter.sentiment == 'positive' %}selected{% endif %}>Positif</option>
                                    <option value="neutral" {% if filter.sentiment == 'neutral' %}selected{% endif %}>Neutre</option>
                                    <option value="negative" {% if filter.sentiment == 'negative' %}selected{% endif %}>Négatif</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="mt-6 flex justify-end gap-3">
                            <a href="{{ path('app_admin_avis_index') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors duration-200">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                Réinitialiser
                            </a>
                            <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors duration-200">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                                </svg>
                                Filtrer
                            </button>
                        </div>
                    </form>
                    
                    <!-- Active Filters -->
                    {% if filter.note or filter.date or filter.sentiment %}
                        <div class="mt-6 pt-4 border-t border-gray-200">
                            <h3 class="text-sm font-medium text-gray-700 mb-3 flex items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                Filtres actifs
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                {% if filter.note %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                        </svg>
                                        Note: {{ filter.note }} étoile{% if filter.note != '1' %}s{% endif %}
                                    </span>
                                {% endif %}
                                
                                {% if filter.date %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        Période: 
                                        {% if filter.date == 'today' %}Aujourd'hui
                                        {% elseif filter.date == 'week' %}Cette semaine
                                        {% elseif filter.date == 'month' %}Ce mois
                                        {% elseif filter.date == 'year' %}Cette année
                                        {% endif %}
                                    </span>
                                {% endif %}
                                
                                {% if filter.sentiment %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        Sentiment: 
                                        {% if filter.sentiment == 'positive' %}Positif
                                        {% elseif filter.sentiment == 'neutral' %}Neutre
                                        {% elseif filter.sentiment == 'negative' %}Négatif
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Reviews Table -->
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Passager</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Conducteur</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Note</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                    {% for avis in avis %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                                {{ avis.id }}
                            </td>
                            <td class="px-4 py-3 text-sm">
                                {% if avis.passager %}
                                    <div class="flex items-center">
                                        {% if avis.passager.imagePath %}
                                            <img src="{{ asset(avis.passager.imagePath) }}" alt="{{ avis.passager.prenom }}" class="h-8 w-8 rounded-full mr-2 object-cover">
                                        {% else %}
                                            <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center mr-2 text-gray-600 font-medium">
                                                {{ avis.passager.prenom|first }}{{ avis.passager.nom|first }}
                                            </div>
                                        {% endif %}
                                        <span>{{ avis.passager.prenom }} {{ avis.passager.nom }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-gray-500">Utilisateur supprimé</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-sm">
                                {% if avis.conducteur %}
                                    <div class="flex items-center">
                                        {% if avis.conducteur.imagePath %}
                                            <img src="{{ asset(avis.conducteur.imagePath) }}" alt="{{ avis.conducteur.prenom }}" class="h-8 w-8 rounded-full mr-2 object-cover">
                                        {% else %}
                                            <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center mr-2 text-gray-600 font-medium">
                                                {{ avis.conducteur.prenom|first }}{{ avis.conducteur.nom|first }}
                                            </div>
                                        {% endif %}
                                        <span>{{ avis.conducteur.prenom }} {{ avis.conducteur.nom }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-gray-500">Utilisateur supprimé</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-sm">
                                <div class="rating">
                                    {% for i in 1..5 %}
                                        {% if i <= avis.rating %}
                                            <span class="rating-star">★</span>
                                        {% else %}
                                            <span class="rating-star text-gray-300">★</span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="px-4 py-3 text-sm">
                                {{ avis.date ? avis.date|date('d/m/Y') : '' }}
                            </td>
                            <td class="px-4 py-3 text-sm">
                                <a href="{{ path('app_admin_avis_show', {'id': avis.id}) }}" class="px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-primary-600 border border-transparent rounded-md active:bg-primary-600 hover:bg-primary-700 focus:outline-none focus:shadow-outline-primary">
                                    <i class="fas fa-eye mr-1"></i> Voir
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="px-4 py-3 text-sm text-center text-gray-500">
                                Aucun avis trouvé avec les filtres sélectionnés.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Toggle dropdown menu
        document.addEventListener('DOMContentLoaded', function() {
            const dropdown = document.querySelector('.dropdown');
            const dropdownMenu = document.querySelector('.dropdown-menu');
            
            dropdown.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdownMenu.classList.toggle('hidden');
            });
            
            document.addEventListener('click', function() {
                if (!dropdownMenu.classList.contains('hidden')) {
                    dropdownMenu.classList.add('hidden');
                }
            });
        });
    </script>
{% endblock %} 