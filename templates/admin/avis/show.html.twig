{% extends 'base.html.twig' %}

{% block title %}Détail de l'avis{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .rating-large {
            display: inline-flex;
            margin-right: 0.5rem;
        }
        .rating-star {
            color: #EAB308;
            font-size: 1.5rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden p-6">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-6">
                    <div>
                        <h1 class="text-3xl font-bold bg-gradient-to-r from-green-600 to-green-700 bg-clip-text text-transparent">Détail de l'avis #{{ avis.id }}</h1>
                        <p class="text-gray-500 mt-1">Consultation et réponse à l'avis</p>
                        <div class="h-1 w-32 bg-gradient-to-r from-green-500 to-green-600 rounded mt-2"></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_admin_avis_index') }}" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                            Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Review Details -->
            <div class="bg-gray-50 rounded-lg p-6 mb-8">
                <div class="flex flex-col md:flex-row justify-between mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 mb-2">Détails de l'avis</h2>
                        <div class="flex items-center mb-4">
                            <div class="rating-large">
                                {% for i in 1..5 %}
                                    {% if i <= avis.rating %}
                                        <span class="rating-star">★</span>
                                    {% else %}
                                        <span class="rating-star text-gray-300">★</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <span class="text-lg font-semibold ml-2">{{ avis.rating }}/5</span>
                        </div>
                        <div class="text-gray-700 mb-4">
                            <p class="font-medium">Commentaire:</p>
                            <div class="mt-2 p-4 bg-white rounded-lg border border-gray-200">
                                {% if avis.commentaire %}
                                    {{ avis.commentaire }}
                                {% else %}
                                    <span class="text-gray-500 italic">Aucun commentaire laissé</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="text-sm text-gray-600">
                            <div class="mb-1">
                                <span class="font-medium">Date:</span> {{ avis.date ? avis.date|date('d/m/Y H:i') : 'Non spécifiée' }}
                            </div>
                            
                            {% if avis.commentaire %}
                                <div class="mb-1">
                                    <span class="font-medium">Sentiment:</span>
                                    {% set sentiment = 'neutral' %}
                                    {% if avis.commentaire %}
                                        {% set text = avis.commentaire|lower %}
                                        {% set positive_words = ['bien', 'super', 'excellent', 'génial', 'parfait', 'satisfait', 'merci', 'agréable', 'recommande', 'ponctuel', 'sympathique', 'souriant', 'propre'] %}
                                        {% set negative_words = ['mauvais', 'horrible', 'déçu', 'déception', 'décevant', 'problème', 'retard', 'pas', 'jamais', 'sale', 'dangereux', 'dommage', 'malheureusement'] %}
                                        
                                        {% set positive_count = 0 %}
                                        {% set negative_count = 0 %}
                                        
                                        {% for word in positive_words %}
                                            {% if text matches '%' ~ word ~ '%' %}
                                                {% set positive_count = positive_count + 1 %}
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% for word in negative_words %}
                                            {% if text matches '%' ~ word ~ '%' %}
                                                {% set negative_count = negative_count + 1 %}
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if positive_count > negative_count %}
                                            {% set sentiment = 'positive' %}
                                        {% elseif negative_count > positive_count %}
                                            {% set sentiment = 'negative' %}
                                        {% endif %}
                                    {% endif %}
                                    
                                    {% if sentiment == 'positive' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Positif 😊
                                        </span>
                                    {% elseif sentiment == 'negative' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            Négatif 😞
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            Neutre 😐
                                        </span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- User Details -->
                    <div class="mt-6 md:mt-0 md:ml-8 bg-white p-4 rounded-lg shadow-sm border border-gray-200">
                        <h3 class="font-semibold text-gray-700 mb-3">Utilisateurs concernés</h3>
                        <div class="flex flex-col space-y-4">
                            <!-- Passager -->
                            <div>
                                <p class="text-sm font-medium text-gray-500 mb-2">Passager:</p>
                                {% if avis.passager %}
                                    <div class="flex items-center">
                                        {% if avis.passager.imagePath %}
                                            <img src="{{ asset(avis.passager.imagePath) }}" alt="{{ avis.passager.prenom }}" class="h-10 w-10 rounded-full mr-2 object-cover">
                                        {% else %}
                                            <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center mr-2 text-blue-500 font-medium">
                                                {{ avis.passager.prenom|first }}{{ avis.passager.nom|first }}
                                            </div>
                                        {% endif %}
                                        <div>
                                            <p class="font-medium">{{ avis.passager.prenom }} {{ avis.passager.nom }}</p>
                                            <p class="text-xs text-gray-500">{{ avis.passager.email }}</p>
                                        </div>
                                    </div>
                                {% else %}
                                    <p class="text-sm text-gray-500 italic">Passager supprimé</p>
                                {% endif %}
                            </div>
                            
                            <!-- Conducteur -->
                            <div>
                                <p class="text-sm font-medium text-gray-500 mb-2">Conducteur:</p>
                                {% if avis.conducteur %}
                                    <div class="flex items-center">
                                        {% if avis.conducteur.imagePath %}
                                            <img src="{{ asset(avis.conducteur.imagePath) }}" alt="{{ avis.conducteur.prenom }}" class="h-10 w-10 rounded-full mr-2 object-cover">
                                        {% else %}
                                            <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center mr-2 text-green-500 font-medium">
                                                {{ avis.conducteur.prenom|first }}{{ avis.conducteur.nom|first }}
                                            </div>
                                        {% endif %}
                                        <div>
                                            <p class="font-medium">{{ avis.conducteur.prenom }} {{ avis.conducteur.nom }}</p>
                                            <p class="text-xs text-gray-500">{{ avis.conducteur.email }}</p>
                                        </div>
                                    </div>
                                {% else %}
                                    <p class="text-sm text-gray-500 italic">Conducteur supprimé</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Responses Section -->
            <div class="mb-8">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Réponses à l'avis</h2>
                {% if avis.reponses|length > 0 %}
                    <div class="space-y-4">
                        {% for reponse in avis.reponses %}
                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <div class="flex items-start">
                                    {% if reponse.admin.imagePath is defined and reponse.admin.imagePath %}
                                        <img src="{{ asset(reponse.admin.imagePath) }}" alt="{{ reponse.admin.prenom }}" class="h-10 w-10 rounded-full mr-4 object-cover">
                                    {% else %}
                                        <div class="h-10 w-10 rounded-full bg-purple-100 flex items-center justify-center mr-4 text-purple-500 font-medium">
                                            {{ reponse.admin.prenom|first }}{{ reponse.admin.nom|first }}
                                        </div>
                                    {% endif %}
                                    <div class="flex-1">
                                        <div class="flex items-center justify-between mb-2">
                                            <div>
                                                <p class="font-medium">{{ reponse.admin.prenom }} {{ reponse.admin.nom }}</p>
                                                <p class="text-xs text-gray-500">Admin • {{ reponse.date|date('d/m/Y H:i') }}</p>
                                            </div>
                                        </div>
                                        <div class="text-gray-700">
                                            {{ reponse.contenu }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-8 bg-gray-50 rounded-lg border border-gray-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                        <p class="text-gray-600 mb-2">Aucune réponse n'a été ajoutée à cet avis</p>
                    </div>
                {% endif %}
            </div>
            
            <!-- Add Response Form -->
            <div>
                <h2 class="text-xl font-bold text-gray-800 mb-4">Ajouter une réponse</h2>
                {{ form_start(form, {'attr': {'class': 'bg-gray-50 p-6 rounded-lg border border-gray-200'}}) }}
                    <div class="mb-4">
                        {{ form_label(form.contenu, 'Votre réponse', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.contenu, {'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-green-300 focus:ring focus:ring-green-200 focus:ring-opacity-50', 'rows': 4}}) }}
                        {{ form_errors(form.contenu) }}
                    </div>
                    <div class="flex justify-end">
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-md">
                            Envoyer la réponse
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %} 